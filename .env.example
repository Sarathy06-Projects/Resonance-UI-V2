# Neon Postgres connection string
# Get this from your Neon project dashboard -> Connection Details (use the "pooled" connection string)
DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require"

# Better Auth
# Generate a random secret: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Public app URL, used by the auth client
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Resonance backend (Resonancebackendv2) API base URL
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email. "console" just logs the message body - fine for local dev, and it
# is how scripts/verify-email-e2e.mjs reads back the codes it tests with.
#
# REQUIRED IN PRODUCTION. These now carry signup email verification as well
# as password reset, and both are code-based: a user who never receives the
# mail cannot finish signing up or recover an account. Leaving EMAIL_DRIVER
# unset in production means it silently falls back to "console", every code
# goes to the server log instead of the user, and signup is a dead end.
#
# Set these on the host running the Next.js app (Vercel - this app is the
# Better Auth server), NOT on the Azure App Service that runs the Express
# API. Azure never sends this mail.
EMAIL_DRIVER="console"
RESEND_API_KEY=""
# Must be a domain verified in Resend, otherwise sends are rejected.
EMAIL_FROM="Resonance <noreply@resonance.org.in>"
